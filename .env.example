# Clave publica del widget anti-bot Cloudflare Turnstile (expuesta al cliente)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=

# Clave secreta de Turnstile. SOLO en el servidor (Serverless Function /api/quote)
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Numero oficial de WhatsApp del taller en formato internacional sin simbolos
NEXT_PUBLIC_WHATSAPP_PHONE=584143410187
