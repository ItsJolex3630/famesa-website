# ---------------------------------------------------------------------------
# Famesa C.A. - Variables de entorno
# Copie este archivo como `.env.local` (nunca versione `.env.local`)
# ---------------------------------------------------------------------------

# Clave publica del widget anti-bot Cloudflare Turnstile (expuesta al cliente)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=

# Clave secreta de Turnstile. SOLO en el servidor (Serverless Function /api/quote)
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Numero oficial de WhatsApp del taller en formato internacional sin simbolos
NEXT_PUBLIC_WHATSAPP_PHONE=584143410187

# ---------------------------------------------------------------------------
# FAMESA SUITE · Base de datos Turso (libSQL) — SOLO servidor
# Nunca usar prefijos NEXT_PUBLIC_ / VITE_: el token jamas debe llegar al navegador.
# En Cloudflare Pages se configuran como variables de entorno del proyecto
# (o en `.dev.vars` para desarrollo local).
# ---------------------------------------------------------------------------
TURSO_URL=libsql://famesa-itsjolex3630.aws-us-east-1.turso.io
TURSO_AUTH_TOKEN=

# Secreto para firmar los JWT de sesion del panel (/admin).
# Debe ser una cadena aleatoria fuerte (minimo 16 caracteres). En produccion es
# OBLIGATORIO: sin el, el middleware deniega todo acceso al panel (fail-closed).
ADMIN_JWT_SECRET=

# Clave API maestra de administracion para el panel FAMESA SUITE.
# Debe ser una cadena aleatoria criptograficamente fuerte (minimo 32 caracteres).
# Generar con: openssl rand -hex 32
# Permite el acceso programatico a /api/admin/* mediante la cabecera x-api-key.
# Si no esta definida o es insegura, el sistema deniega el acceso (fail-closed).
ADMIN_API_KEY=

# Contrasena de arranque para los usuarios semilla sin password_hash.
ADMIN_DEV_PASSWORD=

# ---------------------------------------------------------------------------
# Asistente Virtual Inteligente (Opcional)
# Si no se configura, el asistente usa el motor determinista local con la base
# de conocimiento tecnica de FAMESA (sin llamadas externas). SOLO servidor.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
